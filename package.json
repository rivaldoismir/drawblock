{
  "name": "drawblock",
  "private": false,
  "version": "1.0.0",
  "description": "Local-first, offline workspace for Markdown notes and Excalidraw sketches. Your files stay on your disk.",
  "license": "MIT",
  "author": "Rivaldo Ismir (https://github.com/rivaldoismir)",
  "homepage": "https://drawblock.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivaldoismir/drawblock.git"
  },
  "bugs": {
    "url": "https://github.com/rivaldoismir/drawblock/issues"
  },
  "keywords": [
    "markdown",
    "notes",
    "excalidraw",
    "blocknote",
    "local-first",
    "offline-first",
    "pwa",
    "file-system-access-api",
    "diagram",
    "knowledge-base"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "stats:repo": "node scripts/repo-stats.mjs",
    "predev": "npm run sync:fonts",
    "prebuild": "npm run sync:fonts"
  },
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@blocknote/mantine": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@vercel/analytics": "2.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "nanoid": "3.3.20",
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "katex": "0.19.1",
    "workbox-build": {
      "glob": "14.0.4"
    }
  }
}
